{
  "name": "frame2frame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/client/app.ts --bundle --minify --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply frame2frame --local",
    "db:migrate:remote": "wrangler d1 migrations apply frame2frame --remote",
    "token": "bash scripts/update-token.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250512.0",
    "@spectrum-web-components/accordion": "^1.12.2",
    "@spectrum-web-components/action-button": "^1.12.2",
    "@spectrum-web-components/avatar": "^1.12.2",
    "@spectrum-web-components/button": "^1.12.2",
    "@spectrum-web-components/dropzone": "^1.12.2",
    "@spectrum-web-components/field-label": "^1.12.2",
    "@spectrum-web-components/progress-bar": "^1.12.2",
    "@spectrum-web-components/switch": "^1.12.2",
    "@spectrum-web-components/theme": "^1.12.2",
    "@spectrum-web-components/toast": "^1.12.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
